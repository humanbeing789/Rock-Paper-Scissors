import pygame
import random
import os

fullscreen = True
square = False
rando = True
pixlesx = 16
FPS = 6
brightness = 50
xscreen = 900
yscreen = 900
pixlesy = int((pixlesx/xscreen)*yscreen)
# pixlesy =
simulate = False
border = 3
smooth = True


